# Metabase BI — Environment Variables
# Copy this file to .env and fill in real values before running docker compose up

# ─── Metabase Internal Postgres ────────────────────────────────────────────────
# Strong password for the metabase app database (NOT Supabase)
METABASE_DB_PASSWORD=change_me_before_deploy

# ─── Metabase Admin Setup ──────────────────────────────────────────────────────
METABASE_ADMIN_EMAIL=harrison@viterbofoods.com

# ─── Supabase Read-Only Connection (set inside Metabase UI after launch) ───────
# These are NOT used by Docker — they are for reference when connecting via
# Metabase Admin → Databases → Add Database
#
# Host:     aws-0-ap-southeast-1.pooler.supabase.com
# Port:     5432
# Database: postgres
# User:     metabase_reader    (created by migration 20260911000000)
# Password: <set in Supabase SQL editor when creating the role>
# SSL:      required
