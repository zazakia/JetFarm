{
  "name": "jetfarm",
  "version": "0.1.0",
  "main": "index.js",
  "scripts": {
    "prepare:app": "npm run generate:updates && node scripts/check-auth-schema.mjs",
    "prestart": "npm run prepare:app",
    "start": "expo start",
    "prestart:local": "npm run prepare:app",
    "start:local": "expo start --clear",
    "start:prod": "node scripts/start-prod.mjs",
    "preandroid": "npm run prepare:app",
    "android": "expo run:android",
    "android:production": "node scripts/build-android-production.mjs",
    "preios": "npm run prepare:app",
    "ios": "expo run:ios",
    "preweb": "npm run prepare:app",
    "web": "expo start --web",
    "preweb:local": "npm run prepare:app",
    "web:local": "expo start --web --clear",
    "preexport:web": "npm run generate:updates",
    "export:web": "npx expo export --platform web",
    "generate:updates": "node scripts/generate-app-updates.mjs",
    "test": "jest",
    "test:e2e": "npx playwright test",
    "test:sync": "npx playwright test tests/sync-verify.spec.ts --reporter=list",
    "check:sync": "node scripts/verify-sync-integrity.mjs",
    "check:sync:verbose": "node scripts/verify-sync-integrity.mjs --verbose",
    "export:web:production": "node scripts/export-web-production.mjs",
    "export:web:staging": "node scripts/export-web-staging.mjs",
    "start:staging": "node scripts/start-staging.mjs",
    "test:staging": "node scripts/test-staging-server.mjs",
    "deploy:staging": "node scripts/deploy-cloudflare-staging.mjs",
    "migrate:staging": "node scripts/apply-staging-migrations.mjs",
    "deploy:cloudflare": "npm version patch --no-git-tag-version && node scripts/deploy-cloudflare.mjs",
    "workflow:e2e": "node scripts/pipeline-e2e.mjs",
    "deploy:pipeline": "node scripts/pipeline-e2e.mjs --deploy",
    "postinstall": "patch-package",
    "prepare": "husky",
    "lint": "expo lint"
  },
  "dependencies": {
    "@babel/plugin-proposal-decorators": "7.25.9",
    "@expo/metro-runtime": "~55.0.12",
    "@expo/vector-icons": "15.0.3",
    "@hookform/resolvers": "3.9.1",
    "@nozbe/watermelondb": "0.27.1",
    "@nozbe/with-observables": "^1.6.0",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "8.6.0",
    "@react-native-community/netinfo": "11.5.2",
    "@react-navigation/elements": "2.9.10",
    "@supabase/supabase-js": "^2.106.1",
    "@types/crypto-js": "^4.2.2",
    "babel-plugin-inline-dotenv": "^1.7.0",
    "bcryptjs": "^3.0.3",
    "crypto-js": "^4.2.0",
    "date-fns": "^4.1.0",
    "eslint-config-expo": "~55.0.1",
    "exceljs": "^4.4.0",
    "expo": "~55.0.29",
    "expo-blur": "~55.0.17",
    "expo-build-properties": "~55.0.17",
    "expo-constants": "~55.0.16",
    "expo-crypto": "~55.0.18",
    "expo-document-picker": "~55.0.16",
    "expo-file-system": "~55.0.25",
    "expo-font": "~55.0.8",
    "expo-haptics": "~55.0.17",
    "expo-intent-launcher": "~55.0.16",
    "expo-linear-gradient": "~55.0.17",
    "expo-linking": "~55.0.17",
    "expo-print": "~55.0.18",
    "expo-router": "~55.0.18",
    "expo-secure-store": "~55.0.17",
    "expo-sharing": "~55.0.23",
    "expo-sqlite": "~55.0.19",
    "expo-status-bar": "~55.0.6",
    "lokijs": "^1.5.12",
    "nativewind": "^4.2.2",
    "pg": "^8.20.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-hook-form": "7.53.2",
    "react-native": "0.83.10",
    "react-native-chart-kit": "^6.12.0",
    "react-native-gesture-handler": "~2.30.0",
    "react-native-reanimated": "4.2.1",
    "react-native-safe-area-context": "~5.6.2",
    "react-native-screens": "~4.23.0",
    "react-native-svg": "15.15.3",
    "react-native-toast-message": "^2.3.3",
    "react-native-url-polyfill": "^3.0.0",
    "react-native-uuid": "^2.0.3",
    "react-native-web": "^0.21.2",
    "react-native-worklets": "0.7.4",
    "react-native-worklets-core": "^1.6.3",
    "tailwindcss": "^3.4.19",
    "zod": "^4.3.6",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@babel/plugin-transform-class-properties": "^7.28.6",
    "@babel/plugin-transform-private-methods": "^7.28.6",
    "@babel/plugin-transform-private-property-in-object": "^7.28.6",
    "@babel/plugin-transform-typescript": "^7.28.6",
    "@morrowdigital/watermelondb-expo-plugin": "^2.3.3",
    "@playwright/test": "^1.58.2",
    "@testing-library/jest-native": "^5.4.3",
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "29.5.14",
    "@types/node": "^25.5.0",
    "@types/react": "~19.2.10",
    "babel-plugin-transform-typescript-metadata": "^0.4.0",
    "babel-preset-expo": "^55.0.10",
    "eslint": "^9.39.1",
    "husky": "^9.1.7",
    "jest": "~29.7.0",
    "jest-expo": "~55.0.21",
    "patch-package": "^8.0.0",
    "postinstall-postinstall": "^2.1.0",
    "reflect-metadata": "^0.2.2",
    "ts-morph": "^28.0.0",
    "typescript": "~5.9.2",
    "vercel": "^51.4.0",
    "xlsx": "^0.18.5"
  },
  "private": true,
  "expo": {
    "install": {
      "exclude": [
        "expo",
        "expo-blur",
        "expo-build-properties",
        "expo-crypto",
        "expo-document-picker",
        "expo-file-system",
        "expo-haptics",
        "expo-linear-gradient",
        "expo-linking",
        "expo-print",
        "expo-router",
        "expo-secure-store",
        "expo-sharing",
        "expo-sqlite",
        "jest-expo"
      ]
    },
    "doctor": {
      "reactNativeDirectoryCheck": {
        "exclude": [
          "@nozbe/watermelondb",
          "@nozbe/simdjson"
        ]
      }
    }
  },
  "overrides": {
    "@nozbe/watermelondb": {
      "@babel/runtime": "^7.28.6"
    }
  }
}
