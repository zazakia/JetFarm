# Copy to .env.neon and fill in values from Neon.
# Do not commit .env.neon.

# Required: Neon API key and project ID
NEON_API_KEY=your_neon_api_key
NEON_PROJECT_ID=your_neon_project_id

# Existing branch mode
BRANCH_ID=your_branch_id

# Optional host port for local tools on your machine.
# Apps inside Docker should use neon-db:5432.
NEON_LOCAL_PORT=45532

# Connection strings:
# - From host machine:
#   postgres://neon:npg@localhost:45532/neondb?sslmode=require
# - From another Docker Compose service on this network:
#   postgres://neon:npg@neon-db:5432/neondb?sslmode=require

