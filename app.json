{
  "expo": {
    "name": "Agri-One",
    "slug": "agri-one",
    "version": "0.1.8",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.jetfarm.app",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Allow Agri-One to use your location to map farm parcel boundaries."
      }
    },
    "android": {
      "versionCode": 9,
      "adaptiveIcon": {
        "backgroundColor": "#155F2E",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.jetfarm.app",
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow Agri-One to use your location to map farm parcel boundaries."
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "packagingOptions": {
              "pickFirst": [
                "**/libc++_shared.so"
              ]
            }
          }
        }
      ],
      [
        "@morrowdigital/watermelondb-expo-plugin",
        {
          "disableJsi": true
        }
      ],
      "expo-sharing",
      "expo-sqlite",
      "@react-native-community/datetimepicker",
      "expo-font",
      "expo-secure-store"
    ],
    "scheme": "jetfarm",
    "extra": {
      "router": {}
    }
  }
}
