EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:46421
EXPO_PUBLIC_SUPABASE_ANON_KEY=
# Server/local scripts only. Never prefix database passwords with EXPO_PUBLIC_.
SUPABASE_DB_PASSWORD=postgres
SUPABASE_DB_PORT=46422
EXPO_PUBLIC_REGISTER_BORROWER_FUNCTION_ENABLED=false
EXPO_PUBLIC_ENABLE_CONFIG_SYNC=false
EXPO_PUBLIC_ENABLE_QUICK_LOGIN=false

# Canonical release origin that serves /download and /version.json. Leave unset for local
# web development (the browser origin is used); set it for native/production builds.
EXPO_PUBLIC_APP_URL=https://jetfarm.pages.dev

# Security & Encryption Configuration
EXPO_PUBLIC_ENCRYPTION_KEY=
EXPO_PUBLIC_LEGACY_ENCRYPTION_KEY=
EXPO_PUBLIC_E2E_TEST_PASSWORD=
